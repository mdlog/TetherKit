# Copy to .env.local (never commit real values).

# Production signaling relay (wss://). Leave empty in dev: Vite proxies /tether-signal to the local relay.
VITE_SIGNALING_URL=

# Optional JSON array of RTCIceServer, e.g. add a TURN server for strict networks.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# Optional public origin used in the QR code (e.g. an HTTPS tunnel URL).
VITE_PUBLIC_ORIGIN=

# Link to the sibling app (phantom-beam). Dev default: same host, port 5174.
VITE_SIBLING_URL=

# Dev only: set to 0 to serve plain HTTP; RELAY_URL overrides the proxied relay.
# Behind an HTTPS tunnel that forwards to http://localhost:<port>, use DEV_HTTPS=0
# and list the tunnel hostname in DEV_ALLOWED_HOSTS.
# DEV_HTTPS=0
# DEV_ALLOWED_HOSTS=tetherkit.example.com
# RELAY_URL=http://localhost:8787
