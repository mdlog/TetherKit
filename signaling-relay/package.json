{
  "name": "signaling-relay",
  "version": "0.1.0",
  "description": "TetherKit WebSocket signaling server with relay fallback (in-memory rooms, no database).",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.cjs --external:bufferutil --external:utf-8-validate",
    "start": "node dist/server.cjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tetherkit-core": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
